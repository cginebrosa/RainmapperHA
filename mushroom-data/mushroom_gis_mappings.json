  "derived_rules": [
    {
      "rule_id": "altitude_subalpine_pine_hint",
      "description": "If vegetation mapping is generic pine and DEM altitude is above 1500 m in Pyrenean areas, increase likelihood of forest_subalpine_pine and host_pinus_uncinata, but keep confidence below high unless vegetation layer confirms it.",
      "inputs": [
        "DEM_altitude_m",
        "generic_pine_mapping"
      ],
      "outputs": [
        "forest_subalpine_pine",
        "host_pinus_uncinata"
      ],
      "confidence": "low"
    },
    {
      "rule_id": "calcareous_pine_hint",
      "description": "If pine forest overlaps limestone/dolomite/calcareous marl lithology, add forest_calcareous_pine as derived forest type.",
      "inputs": [
        "pine_mapping",
        "lith_limestone_or_dolomite_or_marl"
      ],
      "outputs": [
        "forest_calcareous_pine"
      ],
      "confidence": "medium"
    },
    {
      "rule_id": "acidic_siliceous_hint",
      "description": "If vegetation overlaps granite/schist/slate/quartzite/siliceous substrate, add soil_acidic and soil_siliceous tendencies.",
      "inputs": [
        "lith_siliceous_or_acidic"
      ],
      "outputs": [
        "soil_acidic",
        "soil_siliceous"
      ],
      "confidence": "medium"
    },
    {
      "rule_id": "riparian_moisture_hint",
      "description": "If hydrography or riparian forest class is present, add feature_riparian_moisture and aspect_riparian as optional microhabitat signals.",
      "inputs": [
        "riparian_mapping_or_distance_to_stream"
      ],
      "outputs": [
        "feature_riparian_moisture",
        "aspect_riparian"
      ],
      "confidence": "medium"
    },
    {
      "rule_id": "burned_area_morchella_hint",
      "description": "If recent burned forest polygon overlaps spring period, add feature_burned_area and habitat_burned_forest signals; exact burn age should be modelled separately.",
      "inputs": [
        "burned_area_mapping",
        "date"
      ],
      "outputs": [
        "feature_burned_area",
        "habitat_burned_forest"
      ],
      "confidence": "low"
    }
  ],
